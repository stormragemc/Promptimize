{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120
    },
    "api/context.js": {
      "maxDuration": 90
    },
    "api/architecture.js": {
      "maxDuration": 90
    },
    "api/architecture-image.js": {
      "maxDuration": 100
    },
    "api/preflight.js": {
      "maxDuration": 90
    },
    "api/evaluation.js": {
      "maxDuration": 90
    }
  },
  "buildCommand": "node tests/check-build.cjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/evaluation-plan",
      "destination": "/api/evaluation?operation=plan"
    },
    {
      "source": "/api/evaluation-preflight",
      "destination": "/api/evaluation?operation=preflight"
    },
    {
      "source": "/api/evaluation-case",
      "destination": "/api/evaluation?operation=case"
    }
  ]
}
